From b893cff4b8199b5da774271321a7de13c95cdd7f Mon Sep 17 00:00:00 2001
From: Jonas Faber <72028327+Jonohas@users.noreply.github.com>
Date: Mon, 12 Oct 2026 16:47:08 +0200
Subject: [PATCH 12/12] SystemUI: keep the Duo unfold pending across sleep

Cancel only clears the pending cover reveal. Clearing the pending unfold made
a fold, sleep, unfold, wake sequence skip the inner overlay and treat the
unfold as a fold.
---
 .../yrrp/DuoFoldOverlayAnimationTest.kt       | 23 +++++++++++++++++++
 .../unfold/yrrp/DuoFoldOverlayAnimation.kt    |  6 ++---
 .../unfold/yrrp/FoldAnimationStyleSelector.kt |  6 ++---
 .../unfold/yrrp/YrrpFoldAnimationStartable.kt |  5 ++--
 4 files changed, 31 insertions(+), 9 deletions(-)

diff --git a/packages/SystemUI/multivalentTests/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimationTest.kt b/packages/SystemUI/multivalentTests/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimationTest.kt
index 22f260c6b175..c530fed1e8f4 100644
--- a/packages/SystemUI/multivalentTests/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimationTest.kt
+++ b/packages/SystemUI/multivalentTests/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimationTest.kt
@@ -48,6 +48,7 @@ import org.junit.runner.RunWith
 import org.mockito.ArgumentCaptor
 import org.mockito.Mockito.atLeastOnce
 import org.mockito.Mockito.never
+import org.mockito.Mockito.times
 import org.mockito.Mockito.verify
 import org.mockito.kotlin.any
 import org.mockito.kotlin.anyOrNull
@@ -323,6 +324,28 @@ class DuoFoldOverlayAnimationTest : SysuiTestCase() {
         verify(innerController, never()).isTouchBlocked = false
     }
 
+    @Test
+    fun foldSleepThenUnfold_stillPlaysUnfold_andIsNotMistakenForFold() {
+        reportFolded(true)
+        isAsleep.value = true
+        processAll()
+        isAsleep.value = false
+        processAll()
+        reportFolded(false)
+
+        underTest.onScreenTurningOn {}
+        processAll()
+        assertThat(runtime.phase).isEqualTo(FoldAnimationPhase.UNFOLDING)
+        verify(innerController).addOverlay(eq(ALPHA_TRANSPARENT), anyOrNull())
+
+        progressProvider.onTransitionStarted()
+        processAll()
+
+        // No second, FOLDING attach for the real unfold.
+        verify(innerController, times(1)).addOverlay(any(), anyOrNull())
+        assertThat(runtime.phase).isEqualTo(FoldAnimationPhase.UNFOLDING)
+    }
+
     @Test
     fun foldOnInner_startsUnblurred_soNoFlashBeforeProgress() {
         selector.onGatedTransitionStarted(progressProvider)
diff --git a/packages/SystemUI/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimation.kt b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimation.kt
index 492dccf7c2ea..2f01ee4e440a 100644
--- a/packages/SystemUI/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimation.kt
+++ b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/DuoFoldOverlayAnimation.kt
@@ -249,8 +249,8 @@ constructor(
 
     private fun cancel(reason: String) {
         bgHandler.removeCallbacks(safetyTimeout)
-        // Pending flags belong to the interrupted cycle; a later wake must not replay them.
-        pendingUnfold = false
+        // A cover reveal does not survive an interruption such as sleep. pendingUnfold stays: the
+        // device is still folded and its unfold screen-on is still due.
         pendingCoverReveal = false
         coverAnimator?.cancel()
         coverWaitJob?.cancel()
@@ -314,8 +314,6 @@ constructor(
                     cancel("FOLDED")
                 } else if (!folded && runtimeState.phase == FoldAnimationPhase.COVER_REVEAL) {
                     cancel("UNFOLDED")
-                    // The unfold this cancel interrupts is real, so its screen-on is still due.
-                    pendingUnfold = true
                 } else if (folded) {
                     bgHandler.removeCallbacks(safetyTimeout)
                     inner.ensureOverlayRemoved()
diff --git a/packages/SystemUI/src/com/android/systemui/unfold/yrrp/FoldAnimationStyleSelector.kt b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/FoldAnimationStyleSelector.kt
index 45b72017e1c3..a941b61681ae 100644
