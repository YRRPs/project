+++ b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/FoldAnimationStyleSelector.kt
@@ -25,9 +25,9 @@ import javax.inject.Singleton
 /**
  * Latches the user's fold animation style when the first gated progress provider starts a
  * transition (or a screen-on handshake calls [latchIfIdle] first) and releases it when the last
- * gated provider finishes, or by force through [releaseAll] on sleep or timeout. Every unfold consumer, Shell included,
- * reads [currentStyle], so one transition never mixes styles. Lives in the global graph because
- * Shell and the unfold library are both resolved there.
+ * gated provider finishes, or by force through [releaseAll] on sleep or timeout. Every unfold
+ * consumer, Shell included, reads [currentStyle], so one transition never mixes styles. Lives in
+ * the global graph because Shell and the unfold library are both resolved there.
  */
 @Singleton
 class FoldAnimationStyleSelector @Inject constructor() :
diff --git a/packages/SystemUI/src/com/android/systemui/unfold/yrrp/YrrpFoldAnimationStartable.kt b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/YrrpFoldAnimationStartable.kt
index 25ae2e37fa6e..dcfdb0360e0c 100644
--- a/packages/SystemUI/src/com/android/systemui/unfold/yrrp/YrrpFoldAnimationStartable.kt
+++ b/packages/SystemUI/src/com/android/systemui/unfold/yrrp/YrrpFoldAnimationStartable.kt
@@ -38,8 +38,9 @@ import kotlinx.coroutines.delay
 
 /**
  * Feeds the per-user setting into [FoldAnimationStyleSelector], logs latch transitions, releases a
- * stuck latch on sleep or after [LATCH_TIMEOUT_MS], and dumps every gate. Dump: `dumpsys activity service com.android.systemui/.SystemUIService
- * YrrpFoldAnimation YrrpFoldAnimationLog`.
+ * stuck latch on sleep or after [LATCH_TIMEOUT_MS], and dumps every gate. Dump:
+ * `dumpsys activity service com.android.systemui/.SystemUIService YrrpFoldAnimation
+ * YrrpFoldAnimationLog`.
  */
 @SysUISingleton
 class YrrpFoldAnimationStartable(
