From 95ddca730fb10bf750805f2b33a2a0f0a4e54e38 Mon Sep 17 00:00:00 2001
From: Yimura <24669514+Yimura@users.noreply.github.com>
Date: Mon, 12 Oct 2026 17:21:21 +0200
Subject: [PATCH 16/17] Shell: squeeze Duo tasks in the unfold start
 transaction

The Duo transform first appeared on the first progress callback, after
screen-on. Pixel hides that gap behind an opaque reveal; Duo's overlay is
transparent, so the inner screen showed full-width content for a frame
before jumping to the cover width. Apply progress 0 in
prepareStartTransaction when the style is Duo.
---
 .../FullscreenUnfoldTaskAnimator.java         |  6 ++++
 .../FullscreenUnfoldTaskAnimatorDuoTest.java  | 29 +++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java b/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
index d0f1984d8f38..aa090a049ae7 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
@@ -230,6 +230,12 @@ public class FullscreenUnfoldTaskAnimator implements UnfoldTaskAnimator,
     @Override
     public void prepareStartTransaction(Transaction transaction) {
         mBackgroundController.ensureBackground(transaction);
+        // Duo: the first unfolded frame must already be squeezed. The overlay above is
+        // transparent, so nothing hides a full-width frame before the first progress arrives.
+        if (isDuo()) {
+            applyDuo(mAnimationContextByTaskId, 0f, transaction);
+            applyDuo(mHomeContextByTaskId, 0f, transaction);
+        }
     }
 
     @Override
diff --git a/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java b/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
index 039f5636fd2d..fbff5fef0cb6 100644
--- a/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
+++ b/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
@@ -121,6 +121,35 @@ public class FullscreenUnfoldTaskAnimatorDuoTest {
         verify(mTransaction).setWindowCrop(leash, new Rect(0, 0, 2268, 2440));
     }
 
+    @Test
+    public void duo_startTransaction_squeezesBeforeFirstProgress() {
+        mStyle = UnfoldAnimationStyleProvider.STYLE_DUO;
+        SurfaceControl app = mock(SurfaceControl.class);
+        SurfaceControl home = mock(SurfaceControl.class);
+        mAnimator.onTaskAppeared(task(1, ACTIVITY_TYPE_STANDARD), app);
+        mAnimator.onTaskAppeared(task(2, ACTIVITY_TYPE_HOME), home);
+
+        mAnimator.prepareStartTransaction(mTransaction);
+
+        for (SurfaceControl leash : new SurfaceControl[] {app, home}) {
+            ArgumentCaptor<Matrix> matrix = ArgumentCaptor.forClass(Matrix.class);
+            verify(mTransaction).setMatrix(eq(leash), matrix.capture(), any());
+            float[] values = new float[9];
+            matrix.getValue().getValues(values);
+            assertThat(values[Matrix.MSCALE_X]).isWithin(1e-4f).of(DuoUnfoldGeometry.scaleX(0f));
+        }
+    }
+
+    @Test
+    public void pixel_startTransaction_leavesTasksUntransformed() {
+        SurfaceControl app = mock(SurfaceControl.class);
+        mAnimator.onTaskAppeared(task(1, ACTIVITY_TYPE_STANDARD), app);
+
+        mAnimator.prepareStartTransaction(mTransaction);
+
+        verify(mTransaction, never()).setMatrix(eq(app), any(Matrix.class), any());
+    }
+
     @Test
     public void duo_resetSurface_restoresIdentityForHome() {
         mStyle = UnfoldAnimationStyleProvider.STYLE_DUO;
