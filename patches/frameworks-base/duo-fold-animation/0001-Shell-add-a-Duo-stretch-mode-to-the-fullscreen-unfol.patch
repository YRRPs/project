+package com.android.wm.shell.unfold.animation;
+
+/** Duo stretch: content starts squeezed to the cover screen's width and widens to full. */
+public final class DuoUnfoldGeometry {
+    /** Cover panel width (1116) over inner panel width (2268) on the OnePlus Open. */
+    public static final float COVER_WIDTH_FRACTION = 1116f / 2268f;
+
+    private DuoUnfoldGeometry() {}
+
+    /** Horizontal content scale for unfold progress 0..1; vertical scale stays 1. */
+    public static float scaleX(float progress) {
+        float p = Math.max(0f, Math.min(1f, progress));
+        return COVER_WIDTH_FRACTION + (1f - COVER_WIDTH_FRACTION) * p;
+    }
+}
