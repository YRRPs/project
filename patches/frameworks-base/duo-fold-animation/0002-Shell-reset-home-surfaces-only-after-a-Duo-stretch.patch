From 5c7c9e3d5ce7a96f5df1e038fdfdb6a5f91e145d Mon Sep 17 00:00:00 2001
From: Jonas Faber <72028327+Jonohas@users.noreply.github.com>
Date: Mon, 12 Oct 2026 16:05:13 +0200
Subject: [PATCH 02/17] Shell: reset home surfaces only after a Duo stretch

Home tasks are now always tracked by the fullscreen unfold animator,
so Pixel and Stock would have written crop, corner radius, matrix and
position to home leashes they never transformed. Reset a home leash
only when Duo transformed it during the transition.
---
 .../FullscreenUnfoldTaskAnimator.java         | 19 +++++++++++++++++--
 .../FullscreenUnfoldTaskAnimatorDuoTest.java  | 10 +++++++++-
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java b/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
index 3ddb2bba1c71..d0f1984d8f38 100644
--- a/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
+++ b/libs/WindowManager/Shell/src/com/android/wm/shell/unfold/animation/FullscreenUnfoldTaskAnimator.java
@@ -173,9 +173,14 @@ public class FullscreenUnfoldTaskAnimator implements UnfoldTaskAnimator,
 
     @Override
     public void resetSurface(TaskInfo taskInfo, Transaction transaction) {
+        final boolean isHome = taskInfo.getActivityType() == ACTIVITY_TYPE_HOME;
         final AnimationContext context = contextsFor(taskInfo).get(taskInfo.taskId);
         if (context != null) {
-            resetSurface(context, transaction);
+            if (isHome) {
+                resetHomeSurface(context, transaction);
+            } else {
+                resetSurface(context, transaction);
+            }
         }
     }
 
@@ -210,6 +215,7 @@ public class FullscreenUnfoldTaskAnimator implements UnfoldTaskAnimator,
         final float scaleX = DuoUnfoldGeometry.scaleX(progress);
         for (int i = contexts.size() - 1; i >= 0; i--) {
             final AnimationContext context = contexts.valueAt(i);
+            context.mDuoTransformed = true;
             context.mCurrentCropRect.set(context.mEndCropRect);
             context.mMatrix.setScale(scaleX, 1f, context.mCurrentCropRect.exactCenterX(),
                     context.mCurrentCropRect.exactCenterY());
@@ -245,10 +251,17 @@ public class FullscreenUnfoldTaskAnimator implements UnfoldTaskAnimator,
             resetSurface(context, transaction);
         }
         for (int i = mHomeContextByTaskId.size() - 1; i >= 0; i--) {
-            resetSurface(mHomeContextByTaskId.valueAt(i), transaction);
+            resetHomeSurface(mHomeContextByTaskId.valueAt(i), transaction);
         }
     }
 
+    /** Resets a home leash only if Duo transformed it, as other styles never touch home. */
+    private void resetHomeSurface(AnimationContext context, Transaction transaction) {
+        if (!context.mDuoTransformed) return;
+        context.mDuoTransformed = false;
+        resetSurface(context, transaction);
+    }
+
     private void resetSurface(AnimationContext context, Transaction transaction) {
         transaction
                 .setWindowCrop(context.mLeash, null)
@@ -267,6 +280,8 @@ public class FullscreenUnfoldTaskAnimator implements UnfoldTaskAnimator,
         final Matrix mMatrix = new Matrix();
 
         TaskInfo mTaskInfo;
+        // Set when Duo transformed this leash, so a later reset is needed.
+        boolean mDuoTransformed;
 
         private AnimationContext(SurfaceControl leash, InsetsSource taskBarInsetsSource,
                 TaskInfo taskInfo) {
diff --git a/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java b/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
index 9493cf7295ab..039f5636fd2d 100644
--- a/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
+++ b/libs/WindowManager/Shell/tests/unittest/src/com/android/wm/shell/unfold/FullscreenUnfoldTaskAnimatorDuoTest.java
@@ -90,11 +90,18 @@ public class FullscreenUnfoldTaskAnimatorDuoTest {
     @Test
     public void pixel_doesNotTouchHomeTask() {
         SurfaceControl leash = mock(SurfaceControl.class);
-        mAnimator.onTaskAppeared(task(1, ACTIVITY_TYPE_HOME), leash);
+        ActivityManager.RunningTaskInfo home = task(1, ACTIVITY_TYPE_HOME);
+        mAnimator.onTaskAppeared(home, leash);
 
         mAnimator.applyAnimationProgress(0.3f, mTransaction);
+        mAnimator.resetAllSurfaces(mTransaction);
+        mAnimator.resetSurface(home, mTransaction);
 
         verify(mTransaction, never()).setMatrix(eq(leash), any(Matrix.class), any());
+        verify(mTransaction, never()).setMatrix(eq(leash), anyFloat(), anyFloat(), anyFloat(),
+                anyFloat());
+        verify(mTransaction, never()).setWindowCrop(eq(leash), any());
+        verify(mTransaction, never()).setPosition(eq(leash), anyFloat(), anyFloat());
     }
 
     @Test
@@ -120,6 +127,7 @@ public class FullscreenUnfoldTaskAnimatorDuoTest {
         SurfaceControl leash = mock(SurfaceControl.class);
         ActivityManager.RunningTaskInfo home = task(1, ACTIVITY_TYPE_HOME);
         mAnimator.onTaskAppeared(home, leash);
+        mAnimator.applyAnimationProgress(0f, mTransaction);
 
         mAnimator.resetSurface(home, mTransaction);
 
