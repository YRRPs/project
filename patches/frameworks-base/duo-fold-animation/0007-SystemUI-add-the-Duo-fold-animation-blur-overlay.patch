+package com.android.systemui.unfold.yrrp
+
+import kotlin.math.roundToInt
+
+/** Duo blur over unfold progress: full at 0, decelerating to none at [BLUR_CLEAR_PROGRESS]. */
+object DuoBlurCurve {
+    const val MAX_BLUR_PX = 120
+    const val BLUR_CLEAR_PROGRESS = 0.85f
+    const val TOUCH_UNBLOCK_PROGRESS = 0.8f
+
+    fun radiusFor(progress: Float): Int {
+        val t = (progress / BLUR_CLEAR_PROGRESS).coerceIn(0f, 1f)
+        val remaining = (1f - t) * (1f - t)
+        return (MAX_BLUR_PX * remaining).roundToInt()
+    }
+}
