diff --git a/cmds/bootanimation/YrrpMatrixShader.h b/cmds/bootanimation/YrrpMatrixShader.h
new file mode 100644
index 000000000000..af91b9acdea1
--- /dev/null
+++ b/cmds/bootanimation/YrrpMatrixShader.h
@@ -0,0 +1,93 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+namespace android::yrrp {
+
+inline constexpr char kMatrixVertexShader[] = R"(
+attribute vec2 aPosition;
+void main() {
+    gl_Position = vec4(aPosition, 0.0, 1.0);
+})";
+
+// Katakana rain with a decoding YRRP mark. Every frame is a pure function of
+// u_time and u_exit. Cell geometry follows the panel's short side, so any
+// aspect ratio gets more cells, never stretched glyphs.
+inline constexpr char kMatrixFragmentShader[] = R"(
+precision highp float;
+uniform sampler2D u_atlas;
+uniform sampler2D u_logo;
+uniform vec2 u_res;
+uniform float u_time;
+uniform float u_exit;
+uniform float u_logoAspect;
+const float CELL = 24.0;
+
+float hash(vec2 q) {
+    q = fract(q * vec2(123.34, 456.21));
+    q += dot(q, q + 45.32);
+    return fract(q.x * q.y);
+}
+
+float glyphAt(float col, float row, vec2 local, float rate) {
+    float tick = floor(u_time * rate + hash(vec2(row, col)) * 9.0);
+    float idx = floor(hash(vec2(col * 1.3 + tick, row * 0.7 + tick * 0.13)) * 64.0);
+    vec2 g = vec2(mod(idx, 8.0), floor(idx / 8.0));
+    return texture2D(u_atlas, (g + local) / 8.0).r;
+}
+
+void main() {
+    float shortSide = min(u_res.x, u_res.y);
+    float cw = CELL * shortSide / 720.0;
+    float ch = cw * 1.25;
+    vec2 px = vec2(gl_FragCoord.x, u_res.y - gl_FragCoord.y);
+    float col = floor(px.x / cw);
+    float row = floor(px.y / ch);
+    vec2 local = vec2(fract(px.x / cw), fract(px.y / ch));
+    float rows = u_res.y / ch;
+    float t = u_time;
+    float colStart = hash(vec2(col, 5.0)) * 1.4;
+
+    float inten = 0.0;
+    float head = 0.0;
+    for (int s = 0; s < 2; s++) {
+        float fs = float(s);
+        float period = mix(1.3, 2.8, hash(vec2(col, fs + 11.0)));
+        float off = hash(vec2(col, fs + 23.0)) * period;
+        float x = (t + off) / period;
+        float n = floor(x);
+        float spawn = n * period - off;
+        float len = mix(8.0, 22.0, hash(vec2(col + n * 0.37, fs + 7.0)));
+        float d = fract(x) * (rows + len) - row;
+        float on = step(0.0, d) * step(d, len) * step(colStart, spawn) * step(spawn, u_exit);
+        float k = 1.0 - d / len;
+        inten = max(inten, on * k * k);
+        head = max(head, on * step(d, 1.0));
+    }
+    float drainRow = mix(-1.0, rows + 1.0, clamp((t - u_exit) / 1.0, 0.0, 1.0));
+    vec3 rain = glyphAt(col, row, local, mix(6.0, 30.0, hash(vec2(col * 3.1, row * 1.7))))
+              * mix(vec3(0.06, 1.0, 0.38) * pow(inten, 1.4), vec3(0.88, 1.0, 0.92), head)
+              * step(drainRow, row);
+
+    float lw = shortSide * 0.86;
+    float lh = lw / u_logoAspect;
+    vec2 centre = vec2((col + 0.5) * cw, (row + 0.5) * ch);
+    vec2 luv = (centre - (u_res - vec2(lw, lh)) * 0.5) / vec2(lw, lh);
+    float inside = step(0.0, luv.x) * step(luv.x, 1.0) * step(0.0, luv.y) * step(luv.y, 1.0);
+    float mask = inside * step(0.5, texture2D(u_logo, clamp(luv, 0.0, 1.0)).r);
+    float reveal = 1.4 + hash(vec2(col, row + 3.0)) * 1.6;
+    float blink = u_exit + hash(vec2(col + 0.5, row + 0.25)) * 0.6;
+    float lit = mask * step(reveal, t) * step(t, blink);
+    float flash = exp(-max(t - reveal, 0.0) * 7.0);
+    float pulse = 0.86 + 0.14 * sin(t * 2.2 + row * 0.35);
+    vec3 logo = glyphAt(col + 101.0, row, local, 2.5) * lit
+              * mix(vec3(0.55, 1.0, 0.68) * pulse, vec3(1.0), flash);
+
+    vec3 outc = max(rain, logo);
+    gl_FragColor = vec4(outc * step(t, u_exit + 1.2), 1.0);
+})";
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp b/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp
new file mode 100644
index 000000000000..f35b2d190dac
--- /dev/null
+++ b/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp
@@ -0,0 +1,21 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+// Prints one YRRP Matrix shader with a GLSL ES 1.00 version line, for
+// glslangValidator. Usage: dump_matrix_shader vert|frag
+#include <cstdio>
+#include <cstring>
+
+#include "YrrpMatrixShader.h"
+
+int main(int argc, char** argv) {
+    if (argc != 2) {
+        return 2;
+    }
+    const bool vertex = strcmp(argv[1], "vert") == 0;
+    printf("#version 100\n%s\n",
+           vertex ? android::yrrp::kMatrixVertexShader : android::yrrp::kMatrixFragmentShader);
+    return 0;
+}
