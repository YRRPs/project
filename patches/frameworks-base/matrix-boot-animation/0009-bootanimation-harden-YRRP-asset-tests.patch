         subprocess.run(
             [sys.executable, "-I", str(GENERATOR), "--kana-font", KANA_FONT,
              "--kana-index", "0", "--logo-font", LOGO_FONT, "--out", str(cls.out)],
             check=True)
-        cls.atlas = Image.open(cls.out / "yrrp-matrix-atlas.png")
