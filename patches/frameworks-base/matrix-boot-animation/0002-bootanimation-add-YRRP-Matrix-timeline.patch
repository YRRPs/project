+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "YrrpMatrixTimeline.h"
+
+#include <algorithm>
+
+namespace android::yrrp {
+
+MatrixTimeline::MatrixTimeline(bool fullIntro, bool shuttingDown)
+      : mFullIntro(fullIntro), mShuttingDown(shuttingDown) {}
+
+void MatrixTimeline::onExitObserved(double seconds) {
+    if (mShuttingDown || mExitObserved) {
+        return;
+    }
+    mExitObserved = true;
+    mExitObservedAt = seconds;
+    mExitTime = mFullIntro ? std::max(seconds, kIntroSeconds) : seconds;
+}
+
+MatrixFrame MatrixTimeline::frame(double seconds) const {
+    const float shaderTime = static_cast<float>(seconds);
+    const MatrixPhase running = seconds < kIntroSeconds ? MatrixPhase::Intro : MatrixPhase::Loop;
+    if (!mExitObserved) {
+        return {shaderTime, kNoExit, running, false};
+    }
+    const float shaderExit = static_cast<float>(mExitTime);
+    if (seconds >= mExitTime + kOutroSeconds) {
+        return {shaderTime, shaderExit, MatrixPhase::Done, true};
+    }
+    if (seconds >= mExitTime) {
+        return {shaderTime, shaderExit, MatrixPhase::Outro, false};
+    }
+    return {shaderTime, shaderExit, running, false};
+}
+
+const char* phaseName(MatrixPhase phase) {
+    switch (phase) {
+        case MatrixPhase::Intro:
+            return "INTRO";
+        case MatrixPhase::Loop:
+            return "LOOP";
+        case MatrixPhase::Outro:
+            return "OUTRO";
+        case MatrixPhase::Done:
+            return "DONE";
+    }
+    return "DONE";
+}
+
+void FrameStats::add(double frameMs) {
+    ++mCount;
+    mTotalMs += frameMs;
+    mMaxMs = std::max(mMaxMs, frameMs);
+}
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/YrrpMatrixTimeline.h b/cmds/bootanimation/YrrpMatrixTimeline.h
new file mode 100644
index 000000000000..17b7e3ee3910
--- /dev/null
+++ b/cmds/bootanimation/YrrpMatrixTimeline.h
@@ -0,0 +1,63 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+namespace android::yrrp {
+
+enum class MatrixPhase { Intro, Loop, Outro, Done };
+
+struct MatrixFrame {
+    float shaderTime;  // seconds since the renderer started
+    float shaderExit;  // outro start in shader time, or kNoExit
+    MatrixPhase phase;
+    bool done;
+};
+
+// Maps real elapsed seconds to shader inputs. Shader time is wall time, so a
+// stalled frame jumps forward instead of slowing down.
+class MatrixTimeline {
+public:
+    static constexpr double kIntroSeconds = 3.0;
+    static constexpr double kOutroSeconds = 1.2;
+    static constexpr float kNoExit = 1.0e6f;
+
+    MatrixTimeline(bool fullIntro, bool shuttingDown);
+
+    // Records the first exit request. Ignored while shutting down, where
+    // power-off ends the animation. With full intro, an exit inside the intro
+    // is deferred to the intro end.
+    void onExitObserved(double seconds);
+    MatrixFrame frame(double seconds) const;
+
+    bool exitObserved() const { return mExitObserved; }
+    double exitObservedAt() const { return mExitObservedAt; }
+    double exitTime() const { return mExitTime; }
+    bool exitDeferred() const { return mExitTime > mExitObservedAt; }
+
+private:
+    bool mFullIntro;
+    bool mShuttingDown;
+    bool mExitObserved = false;
+    double mExitObservedAt = 0.0;
+    double mExitTime = 0.0;
+};
+
+const char* phaseName(MatrixPhase phase);
+
+class FrameStats {
+public:
+    void add(double frameMs);
+    int count() const { return mCount; }
+    double averageMs() const { return mCount == 0 ? 0.0 : mTotalMs / mCount; }
+    double maxMs() const { return mMaxMs; }
+
+private:
+    int mCount = 0;
+    double mTotalMs = 0.0;
+    double mMaxMs = 0.0;
+};
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
index b372f542cec0..33913e72b332 100644
--- a/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
+++ b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
@@ -6,6 +6,7 @@
 #include <gtest/gtest.h>
 
 #include "YrrpMatrixConfig.h"
+#include "YrrpMatrixTimeline.h"
 
 namespace android::yrrp {
 namespace {
@@ -67,3 +68,82 @@ TEST(YrrpMatrixConfigTest, names) {
 
 }  // namespace
 }  // namespace android::yrrp
+
+namespace android::yrrp {
+namespace {
+
+TEST(YrrpMatrixTimelineTest, beforeExitPlaysIntroThenLoop) {
+    const MatrixTimeline timeline(/*fullIntro=*/true, /*shuttingDown=*/false);
+    const MatrixFrame intro = timeline.frame(1.0);
+    EXPECT_EQ(MatrixPhase::Intro, intro.phase);
+    EXPECT_FLOAT_EQ(1.0f, intro.shaderTime);
+    EXPECT_FLOAT_EQ(MatrixTimeline::kNoExit, intro.shaderExit);
+    EXPECT_FALSE(intro.done);
+    EXPECT_EQ(MatrixPhase::Loop, timeline.frame(5.0).phase);
+}
+
+TEST(YrrpMatrixTimelineTest, fullIntroDefersAnEarlyExitToTheIntroEnd) {
+    MatrixTimeline timeline(true, false);
+    timeline.onExitObserved(1.0);
+    EXPECT_TRUE(timeline.exitObserved());
+    EXPECT_DOUBLE_EQ(1.0, timeline.exitObservedAt());
+    EXPECT_DOUBLE_EQ(3.0, timeline.exitTime());
+    EXPECT_TRUE(timeline.exitDeferred());
+    EXPECT_EQ(MatrixPhase::Intro, timeline.frame(2.0).phase);
+    EXPECT_FLOAT_EQ(3.0f, timeline.frame(2.0).shaderExit);
+    EXPECT_EQ(MatrixPhase::Outro, timeline.frame(3.5).phase);
+    EXPECT_FALSE(timeline.frame(4.19).done);
+    EXPECT_EQ(MatrixPhase::Done, timeline.frame(4.2).phase);
+    EXPECT_TRUE(timeline.frame(4.2).done);
+}
+
+TEST(YrrpMatrixTimelineTest, withoutFullIntroAnEarlyExitStartsTheOutroAtOnce) {
+    MatrixTimeline timeline(false, false);
+    timeline.onExitObserved(1.0);
+    EXPECT_DOUBLE_EQ(1.0, timeline.exitTime());
+    EXPECT_FALSE(timeline.exitDeferred());
+    EXPECT_EQ(MatrixPhase::Outro, timeline.frame(1.5).phase);
+    EXPECT_TRUE(timeline.frame(2.2).done);
+}
+
+TEST(YrrpMatrixTimelineTest, aLateExitIsNotDeferredAndOnlyTheFirstCounts) {
+    MatrixTimeline timeline(true, false);
+    timeline.onExitObserved(5.0);
+    timeline.onExitObserved(9.0);
+    EXPECT_DOUBLE_EQ(5.0, timeline.exitTime());
+    EXPECT_FALSE(timeline.exitDeferred());
+    EXPECT_EQ(MatrixPhase::Loop, timeline.frame(4.9).phase);
+    EXPECT_EQ(MatrixPhase::Outro, timeline.frame(5.0).phase);
+}
+
+TEST(YrrpMatrixTimelineTest, shutdownIgnoresExitAndNeverEnds) {
+    MatrixTimeline timeline(true, true);
+    timeline.onExitObserved(1.0);
+    EXPECT_FALSE(timeline.exitObserved());
+    const MatrixFrame frame = timeline.frame(100.0);
+    EXPECT_EQ(MatrixPhase::Loop, frame.phase);
+    EXPECT_FLOAT_EQ(MatrixTimeline::kNoExit, frame.shaderExit);
+    EXPECT_FALSE(frame.done);
+}
+
+TEST(YrrpMatrixTimelineTest, phaseNames) {
+    EXPECT_STREQ("INTRO", phaseName(MatrixPhase::Intro));
+    EXPECT_STREQ("LOOP", phaseName(MatrixPhase::Loop));
+    EXPECT_STREQ("OUTRO", phaseName(MatrixPhase::Outro));
+    EXPECT_STREQ("DONE", phaseName(MatrixPhase::Done));
+}
+
+TEST(YrrpFrameStatsTest, emptyThenAverageAndMax) {
+    FrameStats stats;
+    EXPECT_EQ(0, stats.count());
+    EXPECT_DOUBLE_EQ(0.0, stats.averageMs());
+    EXPECT_DOUBLE_EQ(0.0, stats.maxMs());
+    stats.add(10.0);
+    stats.add(20.0);
+    EXPECT_EQ(2, stats.count());
+    EXPECT_DOUBLE_EQ(15.0, stats.averageMs());
+    EXPECT_DOUBLE_EQ(20.0, stats.maxMs());
+}
+
+}  // namespace
+}  // namespace android::yrrp
