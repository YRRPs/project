+++ b/cmds/bootanimation/YrrpMatrixConfig.h
@@ -0,0 +1,40 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <string>
+
+namespace android::yrrp {
+
+// Written by YRRPs Settings; read once when bootanimation starts. Settings
+// (YrrpBootAnimationStore) parses both values with the same rules.
+inline constexpr char kStyleProp[] = "persist.yrrp.bootanim.style";
+inline constexpr char kFullIntroProp[] = "persist.yrrp.bootanim.full_intro";
+
+enum class MatrixStyle { Matrix, Lineage };
+
+// Matrix: play the YRRP renderer. Stock: continue with the zip path.
+// Exit: end bootanimation at once (shutdown without a Matrix animation).
+enum class MatrixRoute { Matrix, Stock, Exit };
+
+struct MatrixConfig {
+    MatrixStyle style = MatrixStyle::Matrix;
+    bool styleFromProp = false;
+    bool fullIntro = true;
+    bool fullIntroFromProp = false;
+};
+
+// Exact "lineage" or "matrix" select a style; anything else is the Matrix
+// default. "false"/"0" and "true"/"1" set full intro; anything else is true.
+MatrixConfig parseMatrixConfig(const std::string& style, const std::string& fullIntro);
+
+MatrixRoute routeFor(MatrixStyle style, bool shuttingDown);
+MatrixRoute routeAfterInitFailure(bool shuttingDown);
+
+const char* styleName(MatrixStyle style);
+const char* routeName(MatrixRoute route);
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
new file mode 100644
index 000000000000..b372f542cec0
--- /dev/null
+++ b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
@@ -0,0 +1,69 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <gtest/gtest.h>
+
+#include "YrrpMatrixConfig.h"
+
+namespace android::yrrp {
+namespace {
+
+TEST(YrrpMatrixConfigTest, unsetPropertiesUseDefaults) {
+    const MatrixConfig config = parseMatrixConfig("", "");
+    EXPECT_EQ(MatrixStyle::Matrix, config.style);
+    EXPECT_FALSE(config.styleFromProp);
+    EXPECT_TRUE(config.fullIntro);
+    EXPECT_FALSE(config.fullIntroFromProp);
+}
+
+TEST(YrrpMatrixConfigTest, knownStylesComeFromTheProperty) {
+    EXPECT_EQ(MatrixStyle::Lineage, parseMatrixConfig("lineage", "").style);
+    EXPECT_TRUE(parseMatrixConfig("lineage", "").styleFromProp);
+    EXPECT_EQ(MatrixStyle::Matrix, parseMatrixConfig("matrix", "").style);
+    EXPECT_TRUE(parseMatrixConfig("matrix", "").styleFromProp);
+}
+
+TEST(YrrpMatrixConfigTest, unknownStyleFallsBackToMatrixDefault) {
+    for (const char* value : {"LINEAGE", "garbage", " lineage", "lineage "}) {
+        const MatrixConfig config = parseMatrixConfig(value, "");
+        EXPECT_EQ(MatrixStyle::Matrix, config.style) << value;
+        EXPECT_FALSE(config.styleFromProp) << value;
+    }
+}
+
+TEST(YrrpMatrixConfigTest, fullIntroAcceptsTrueFalseOneZero) {
+    EXPECT_FALSE(parseMatrixConfig("", "false").fullIntro);
+    EXPECT_FALSE(parseMatrixConfig("", "0").fullIntro);
+    EXPECT_TRUE(parseMatrixConfig("", "true").fullIntro);
+    EXPECT_TRUE(parseMatrixConfig("", "1").fullIntro);
+    EXPECT_TRUE(parseMatrixConfig("", "false").fullIntroFromProp);
+    EXPECT_TRUE(parseMatrixConfig("", "1").fullIntroFromProp);
+}
+
+TEST(YrrpMatrixConfigTest, unknownFullIntroIsTrueDefault) {
+    const MatrixConfig config = parseMatrixConfig("", "maybe");
+    EXPECT_TRUE(config.fullIntro);
+    EXPECT_FALSE(config.fullIntroFromProp);
+}
+
+TEST(YrrpMatrixConfigTest, routes) {
+    EXPECT_EQ(MatrixRoute::Matrix, routeFor(MatrixStyle::Matrix, false));
+    EXPECT_EQ(MatrixRoute::Matrix, routeFor(MatrixStyle::Matrix, true));
+    EXPECT_EQ(MatrixRoute::Stock, routeFor(MatrixStyle::Lineage, false));
+    EXPECT_EQ(MatrixRoute::Exit, routeFor(MatrixStyle::Lineage, true));
+    EXPECT_EQ(MatrixRoute::Stock, routeAfterInitFailure(false));
+    EXPECT_EQ(MatrixRoute::Exit, routeAfterInitFailure(true));
+}
+
+TEST(YrrpMatrixConfigTest, names) {
+    EXPECT_STREQ("matrix", styleName(MatrixStyle::Matrix));
+    EXPECT_STREQ("lineage", styleName(MatrixStyle::Lineage));
+    EXPECT_STREQ("MATRIX", routeName(MatrixRoute::Matrix));
+    EXPECT_STREQ("STOCK", routeName(MatrixRoute::Stock));
+    EXPECT_STREQ("EXIT", routeName(MatrixRoute::Exit));
+}
+
+}  // namespace
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/tests/yrrp/run_host_tests.sh b/cmds/bootanimation/tests/yrrp/run_host_tests.sh
new file mode 100755
index 000000000000..cf7d455fdedb
--- /dev/null
+++ b/cmds/bootanimation/tests/yrrp/run_host_tests.sh
@@ -0,0 +1,29 @@
+#!/bin/bash
+# Builds and runs the pure YRRP Matrix units outside the Android tree, then
+# checks both shaders against the GLSL ES 1.00 grammar. Needs g++, gtest and
+# glslangValidator on the host.
+set -euo pipefail
+here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+src=$(cd "${here}/../.." && pwd)
+out=$(mktemp -d)
+trap 'rm -rf "${out}"' EXIT
+
+units=()
+for unit in YrrpMatrixConfig YrrpMatrixTimeline YrrpMatrixStatus; do
+    if [[ -f "${src}/${unit}.cpp" ]]; then
+        units+=("${src}/${unit}.cpp")
+    fi
+done
+
+g++ -std=c++17 -Wall -Werror -I"${src}" "${units[@]}" "${here}/YrrpMatrixTest.cpp" \
+    -lgtest -lgtest_main -pthread -o "${out}/tests"
+"${out}/tests"
+
+if [[ -f "${src}/YrrpMatrixShader.h" ]]; then
+    g++ -std=c++17 -Wall -Werror -I"${src}" "${here}/dump_matrix_shader.cpp" -o "${out}/dump"
+    "${out}/dump" vert > "${out}/matrix.vert"
+    "${out}/dump" frag > "${out}/matrix.frag"
+    glslangValidator "${out}/matrix.vert"
+    glslangValidator "${out}/matrix.frag"
+fi
+echo "yrrp matrix host checks passed"
