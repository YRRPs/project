diff --git a/cmds/bootanimation/YrrpMatrixStatus.cpp b/cmds/bootanimation/YrrpMatrixStatus.cpp
new file mode 100644
index 000000000000..5b997e6c6ef2
--- /dev/null
+++ b/cmds/bootanimation/YrrpMatrixStatus.cpp
@@ -0,0 +1,44 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "YrrpMatrixStatus.h"
+
+#include <cstdio>
+
+namespace android::yrrp {
+namespace {
+
+std::string configValue(const MatrixStatus& status) {
+    char buffer[92];
+    snprintf(buffer, sizeof(buffer), "style=%s/%s fullIntro=%d/%s shutdown=%d propsReady=%d",
+             styleName(status.config.style), status.config.styleFromProp ? "prop" : "default",
+             status.config.fullIntro ? 1 : 0,
+             status.config.fullIntroFromProp ? "prop" : "default", status.shuttingDown ? 1 : 0,
+             status.propsReady ? 1 : 0);
+    return buffer;
+}
+
+std::string resultValue(const MatrixStatus& status) {
+    char buffer[92];
+    snprintf(buffer, sizeof(buffer), "outcome=%s frames=%d avgMs=%.1f maxMs=%.1f",
+             status.outcome.c_str(), status.frames, status.averageFrameMs, status.maxFrameMs);
+    return buffer;
+}
+
+}  // namespace
+
+std::vector<std::pair<std::string, std::string>> statusProperties(const MatrixStatus& status) {
+    std::vector<std::pair<std::string, std::string>> properties = {
+            {"sys.yrrp.bootanim.config", configValue(status)},
+            {"sys.yrrp.bootanim.route", routeName(status.route)},
+            {"sys.yrrp.bootanim.blocked_by", status.blockedBy},
+    };
+    if (status.route == MatrixRoute::Matrix && !status.outcome.empty()) {
+        properties.emplace_back("sys.yrrp.bootanim.result", resultValue(status));
+    }
+    return properties;
+}
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/YrrpMatrixStatus.h b/cmds/bootanimation/YrrpMatrixStatus.h
new file mode 100644
index 000000000000..d3980486ac1f
--- /dev/null
+++ b/cmds/bootanimation/YrrpMatrixStatus.h
@@ -0,0 +1,32 @@
+/*
+ * SPDX-FileCopyrightText: Yim's Riced ROM Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "YrrpMatrixConfig.h"
+
+namespace android::yrrp {
+
+// The decision of one bootanimation run. Published as sys.yrrp.bootanim.*
+// properties, which outlive logcat rotation until the next boot.
+struct MatrixStatus {
+    MatrixConfig config;
+    bool shuttingDown = false;
+    bool propsReady = false;
+    MatrixRoute route = MatrixRoute::Matrix;
+    std::string blockedBy = "none";  // STYLE_LINEAGE, ASSET_ATLAS, ASSET_LOGO, COMPILE, LINK, GL
+    std::string outcome;             // COMPLETED, EXIT_PENDING, SWAP_FAILED; empty until the end
+    int frames = 0;
+    double averageFrameMs = 0.0;
+    double maxFrameMs = 0.0;
+};
+
+std::vector<std::pair<std::string, std::string>> statusProperties(const MatrixStatus& status);
+
+}  // namespace android::yrrp
diff --git a/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
index 7e980d00470b..e7c81fad5415 100644
--- a/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
+++ b/cmds/bootanimation/tests/yrrp/YrrpMatrixTest.cpp
@@ -5,7 +5,10 @@
 
 #include <gtest/gtest.h>
 
+#include <map>
+
 #include "YrrpMatrixConfig.h"
+#include "YrrpMatrixStatus.h"
 #include "YrrpMatrixTimeline.h"
 
 namespace android::yrrp {
@@ -149,3 +152,68 @@ TEST(YrrpFrameStatsTest, emptyThenAverageAndMax) {
 
 }  // namespace
 }  // namespace android::yrrp
+
+namespace android::yrrp {
+namespace {
+
+std::map<std::string, std::string> asMap(const MatrixStatus& status) {
+    std::map<std::string, std::string> map;
+    for (const auto& [key, value] : statusProperties(status)) {
+        map[key] = value;
+    }
+    return map;
+}
+
+TEST(YrrpMatrixStatusTest, defaultMatrixRunPublishesEveryGate) {
+    MatrixStatus status;
+    status.config = parseMatrixConfig("", "");
+    status.propsReady = true;
+    status.route = MatrixRoute::Matrix;
+    const auto map = asMap(status);
+    EXPECT_EQ("style=matrix/default fullIntro=1/default shutdown=0 propsReady=1",
+              map.at("sys.yrrp.bootanim.config"));
+    EXPECT_EQ("MATRIX", map.at("sys.yrrp.bootanim.route"));
+    EXPECT_EQ("none", map.at("sys.yrrp.bootanim.blocked_by"));
+    EXPECT_EQ(0u, map.count("sys.yrrp.bootanim.result"));
+}
+
+TEST(YrrpMatrixStatusTest, initFailureNamesTheBlockingStage) {
+    MatrixStatus status;
+    status.config = parseMatrixConfig("matrix", "false");
+    status.route = MatrixRoute::Stock;
+    status.blockedBy = "COMPILE";
+    const auto map = asMap(status);
+    EXPECT_EQ("style=matrix/prop fullIntro=0/prop shutdown=0 propsReady=0",
+              map.at("sys.yrrp.bootanim.config"));
+    EXPECT_EQ("STOCK", map.at("sys.yrrp.bootanim.route"));
+    EXPECT_EQ("COMPILE", map.at("sys.yrrp.bootanim.blocked_by"));
+}
+
+TEST(YrrpMatrixStatusTest, finishedRunPublishesTheResult) {
+    MatrixStatus status;
+    status.route = MatrixRoute::Matrix;
+    status.outcome = "COMPLETED";
+    status.frames = 312;
+    status.averageFrameMs = 16.94;
+    status.maxFrameMs = 211.38;
+    EXPECT_EQ("outcome=COMPLETED frames=312 avgMs=16.9 maxMs=211.4",
+              asMap(status).at("sys.yrrp.bootanim.result"));
+}
+
+TEST(YrrpMatrixStatusTest, everyValueFitsAPropertyValue) {
+    MatrixStatus status;
+    status.config = parseMatrixConfig("lineage", "false");
+    status.shuttingDown = true;
+    status.route = MatrixRoute::Matrix;
+    status.blockedBy = "ASSET_ATLAS";
+    status.outcome = "SWAP_FAILED";
+    status.frames = 999999999;
+    status.averageFrameMs = 99999.9;
+    status.maxFrameMs = 99999.9;
+    for (const auto& [key, value] : statusProperties(status)) {
+        EXPECT_LT(value.size(), 92u) << key;  // PROP_VALUE_MAX - 1
+    }
+}
+
+}  // namespace
+}  // namespace android::yrrp
