---
 cmds/bootanimation/YrrpMatrixStatus.cpp       | 44 ++++++++++++
 cmds/bootanimation/YrrpMatrixStatus.h         | 32 +++++++++
 .../tests/yrrp/YrrpMatrixTest.cpp             | 68 +++++++++++++++++++
 3 files changed, 144 insertions(+)
 create mode 100644 cmds/bootanimation/YrrpMatrixStatus.cpp
