From e685420fa44ccebe2d198adc995dd777fe5e66c4 Mon Sep 17 00:00:00 2001
From: Yimura <24669514+Yimura@users.noreply.github.com>
Date: Sun, 11 Oct 2026 16:33:21 +0200
Subject: [PATCH 07/13] bootanimation: keep YRRP glyph hashing stable on long
 boots

Claude-Session: https://claude.ai/code/session_01XSL9fQo2kwe7nBcauq3dtX
---
 cmds/bootanimation/YrrpMatrixShader.h                | 4 +++-
 cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp | 3 +++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/cmds/bootanimation/YrrpMatrixShader.h b/cmds/bootanimation/YrrpMatrixShader.h
index af91b9acdea1..4d8ac2f54d7a 100644
--- a/cmds/bootanimation/YrrpMatrixShader.h
+++ b/cmds/bootanimation/YrrpMatrixShader.h
@@ -16,6 +16,7 @@ void main() {
 // Katakana rain with a decoding YRRP mark. Every frame is a pure function of
 // u_time and u_exit. Cell geometry follows the panel's short side, so any
 // aspect ratio gets more cells, never stretched glyphs.
+// The renderer must pass u_res > 0 and u_logoAspect > 0 (logo height > 0).
 inline constexpr char kMatrixFragmentShader[] = R"(
 precision highp float;
 uniform sampler2D u_atlas;
@@ -33,7 +34,8 @@ float hash(vec2 q) {
 }
 
 float glyphAt(float col, float row, vec2 local, float rate) {
-    float tick = floor(u_time * rate + hash(vec2(row, col)) * 9.0);
+    // Wrapped so fp32 hash inputs stay small on long boots; identical below tick 2048.
+    float tick = mod(floor(u_time * rate + hash(vec2(row, col)) * 9.0), 2048.0);
     float idx = floor(hash(vec2(col * 1.3 + tick, row * 0.7 + tick * 0.13)) * 64.0);
     vec2 g = vec2(mod(idx, 8.0), floor(idx / 8.0));
     return texture2D(u_atlas, (g + local) / 8.0).r;
diff --git a/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp b/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp
index f35b2d190dac..b8f04e1bf4a6 100644
--- a/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp
+++ b/cmds/bootanimation/tests/yrrp/dump_matrix_shader.cpp
@@ -15,6 +15,9 @@ int main(int argc, char** argv) {
         return 2;
     }
     const bool vertex = strcmp(argv[1], "vert") == 0;
+    if (!vertex && strcmp(argv[1], "frag") != 0) {
+        return 2;
+    }
     printf("#version 100\n%s\n",
            vertex ? android::yrrp::kMatrixVertexShader : android::yrrp::kMatrixFragmentShader);
     return 0;
